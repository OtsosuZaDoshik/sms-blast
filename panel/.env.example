# Скопируйте в .env и заполните.
# Эти значения — только начальные: их можно менять на странице «Настройки».

# Адрес телефона в локальной сети (виден в приложении SMS Gateway → Local Server)
GATEWAY_HOST=192.168.1.50
GATEWAY_PORT=8080
GATEWAY_USER=sms
GATEWAY_PASSWORD=

# Код страны по умолчанию для номеров без «+» (7 = Россия/Казахстан)
DEFAULT_COUNTRY_CODE=7

# Веб-панель
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
SECRET_KEY=change-me
